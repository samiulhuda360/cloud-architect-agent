# Everything works without a language model: the rule-based architect designs, and the rule-based readers
# extract policies and briefs. Add a model for the AI agent and for model-based extraction.

# Google Gemini through its OpenAI-compatible endpoint (model gemini-flash-lite-latest by default):
AI_API_KEY=
# AI_MODEL=gemini-flash-lite-latest
# AI_MIN_INTERVAL=2.5              # seconds between model calls, for rate-limited free tiers

# ...or any other OpenAI-compatible endpoint with tool calling (OpenRouter, OpenAI, Azure OpenAI, Ollama, vLLM):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_MAX_TOKENS=8000              # reasoning models spend part of this thinking

# Caches (no Azure account is needed to read prices):
# PRICE_CACHE=cache/prices.sqlite  # Azure Retail Prices API results, kept for a week
# LLM_CACHE=cache/llm.sqlite       # model replies by request; set to "off" to disable
