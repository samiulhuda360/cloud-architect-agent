# Any OpenAI-compatible endpoint with tool calling.
# OpenRouter (default): https://openrouter.ai
OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_MODEL=qwen/qwen3.8-27b:free          # free tier, rate-limited

# ...or Azure OpenAI / a local server (Ollama, vLLM):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
# LLM_MAX_TOKENS=8000              # reasoning models spend part of this thinking

# Prices are cached here for a week (no Azure account needed to read them):
# PRICE_CACHE=cache/prices.sqlite
